import tkinter as tk
from tkinter import ttk, messagebox
import math
import time
import ctypes
try:
    ctypes.windll.shcore.SetProcessDpiAwareness(2)
except:
    pass
from ctypes import wintypes

try:
    import winsound
    SOUND = True
except ImportError:
    SOUND = False

# Stonowany szary — mniej męczy oczy niż jasne #f2f2f2 (szczególnie na TV)
BG_COLOR = "#484848"
BG_SHADOW = "#333333"
TEXT_COLOR = "#E8E8E8"
TEXT_MUTED = "#AAAAAA"

# Pastelowe kolory paska postępu
PROGRESS_GREEN = "#88CE98"
PROGRESS_ORANGE = "#E99E58"
PROGRESS_RED = "#EB6C6C"

MONITORINFOF_PRIMARY = 1


class MONITORINFO(ctypes.Structure):
    _fields_ = [
        ("cbSize", wintypes.DWORD),
        ("rcMonitor", wintypes.RECT),
        ("rcWork", wintypes.RECT),
        ("dwFlags", wintypes.DWORD),
    ]


def get_monitors():
    """Zwraca listę monitorów z flagą primary (Windows)."""
    monitors = []

    def callback(hMonitor, hdcMonitor, lprcMonitor, dwData):
        mi = MONITORINFO()
        mi.cbSize = ctypes.sizeof(MONITORINFO)
        ctypes.windll.user32.GetMonitorInfoW(hMonitor, ctypes.byref(mi))
        rect = mi.rcMonitor
        monitors.append({
            "left": rect.left,
            "top": rect.top,
            "right": rect.right,
            "bottom": rect.bottom,
            "width": rect.right - rect.left,
            "height": rect.bottom - rect.top,
            "primary": bool(mi.dwFlags & MONITORINFOF_PRIMARY),
        })
        return 1

    MONITORENUMPROC = ctypes.WINFUNCTYPE(
        ctypes.c_int,
        ctypes.c_ulong,
        ctypes.c_ulong,
        ctypes.POINTER(wintypes.RECT),
        ctypes.c_double,
    )
    ctypes.windll.user32.EnumDisplayMonitors(0, 0, MONITORENUMPROC(callback), 0)
    return monitors


def pick_monitors(monitors):
    """Panel na monitorze głównym, tarcza na drugim (nie-głównym) ekranie."""
    fallback = {"left": 0, "top": 0, "width": 1920, "height": 1080, "primary": True}
    if not monitors:
        return fallback, fallback

    primary = next((m for m in monitors if m["primary"]), monitors[0])
    others = [m for m in monitors if not m["primary"]]
    secondary = others[0] if others else primary
    return primary, secondary


def place_fullscreen_on_monitor(window, monitor):
    """
    Pełny ekran na wybranym monitorze.
    attributes('-fullscreen') w tkinter zawsze trafia na ekran główny — używamy geometry.
    """
    window.overrideredirect(False)
    window.geometry(
        f"{monitor['width']}x{monitor['height']}"
        f"+{monitor['left']}+{monitor['top']}"
    )
    window.update_idletasks()
    window.overrideredirect(True)
    window.lift()


class AnalogTimer:

    def __init__(self):
        monitors = get_monitors()
        primary, secondary = pick_monitors(monitors)
        self.clock_monitor = secondary

        # ===== Okno sterowania (ekran komputera) =====
        self.control_root = tk.Tk()
        self.control_root.title("Analog Timer — panel sterowania")
        self.control_root.configure(bg=BG_COLOR)
        self.control_root.resizable(False, False)

        panel_w, panel_h = 620, 120
        panel_x = primary["left"] + (primary["width"] - panel_w) // 2
        panel_y = primary["top"] + (primary["height"] - panel_h) // 2
        self.control_root.geometry(f"{panel_w}x{panel_h}+{panel_x}+{panel_y}")

        controls = tk.Frame(self.control_root, bg=BG_COLOR, padx=15, pady=15)
        controls.pack(fill="both", expand=True)

        tk.Label(
            controls,
            text="Czas:",
            bg=BG_COLOR,
            fg=TEXT_COLOR,
            font=("Segoe UI", 11),
        ).grid(row=0, column=0, padx=5)

        self.minutes = tk.IntVar(value=5)

        ttk.Combobox(
            controls,
            width=6,
            textvariable=self.minutes,
            values=list(range(1, 61)),
            state="readonly",
        ).grid(row=0, column=1, padx=5)

        tk.Label(
            controls,
            text="min",
            bg=BG_COLOR,
            fg=TEXT_COLOR,
            font=("Segoe UI", 11),
        ).grid(row=0, column=2)

        tk.Button(
            controls,
            text="Start",
            width=10,
            command=self.start,
        ).grid(row=0, column=3, padx=5)

        tk.Button(
            controls,
            text="Stop",
            width=10,
            command=self.stop,
        ).grid(row=0, column=4, padx=5)

        tk.Button(
            controls,
            text="Reset",
            width=10,
            command=self.reset,
        ).grid(row=0, column=5, padx=5)

        screen_label = (
            f"monitor {monitors.index(secondary) + 1} ({secondary['width']}×{secondary['height']})"
            if len(monitors) > 1
            else "ten sam ekran (brak drugiego monitora)"
        )
        tk.Label(
            controls,
            text=f"Tarcza zegara: {screen_label}",
            bg=BG_COLOR,
            font=("Segoe UI", 9),
            fg=TEXT_MUTED,
        ).grid(row=1, column=0, columnspan=6, pady=(10, 0))

        # ===== Okno tarczy (drugi ekran / TV) =====
        self.clock_root = tk.Toplevel(self.control_root)
        self.clock_root.title("Analog Timer — tarcza")
        self.clock_root.configure(bg=BG_COLOR)
        self.clock_root.protocol("WM_DELETE_WINDOW", self._on_clock_close)

        self.canvas = tk.Canvas(
            self.clock_root,
            bg=BG_COLOR,
            highlightthickness=0,
        )
        self.canvas.pack(expand=True, fill="both")
        self.canvas.bind("<Configure>", self.resize_clock)

        self.cx = secondary["width"] // 2
        self.cy = secondary["height"] // 2
        self.radius = min(secondary["width"], secondary["height"]) // 2 - 40

        self.running = False
        self.total_seconds = 300
        self.remaining = 300
        self.start_time = None
        self.pause_time = 0

        self.draw_clock()
        # Po zmapowaniu okna — pełny ekran na drugim monitorze (nie przez -fullscreen)
        self.clock_root.after_idle(lambda: place_fullscreen_on_monitor(self.clock_root, secondary))

    def _on_clock_close(self):
        self.clock_root.withdraw()

    def resize_clock(self, event):
        size = min(event.width, event.height)
        self.cx = event.width // 2
        self.cy = event.height // 2
        self.radius = size // 2 - 40
        self.draw_clock()

    def draw_clock(self):
        self.canvas.delete("all")

        cx = self.cx
        cy = self.cy
        r = self.radius

        self.canvas.create_oval(
            cx - r + 6, cy - r + 8,
            cx + r + 6, cy + r + 8,
            fill=BG_SHADOW,
            outline="",
        )

        self.canvas.create_oval(
            cx - r, cy - r,
            cx + r, cy + r,
            fill="white",
            outline="#222222",
            width=4,
        )

        remaining_fraction = (
            self.remaining / self.total_seconds if self.total_seconds else 0
        )
        elapsed_fraction = 1 - remaining_fraction

        if remaining_fraction > 0.50:
            progress_color = PROGRESS_GREEN
        elif remaining_fraction > 0.20:
            progress_color = PROGRESS_ORANGE
        else:
            progress_color = PROGRESS_RED

        # Szeroki pierścień postępu na zewnątrz; biała tarcza z kreskami w środku
        ring_width = max(36, int(r * 0.34))
        face_r = r - ring_width

        # Luka rośnie zgodnie z ruchem wskazówek (od 12 w prawo)
        self.canvas.create_arc(
            cx - r, cy - r,
            cx + r, cy + r,
            start=90 - 360 * elapsed_fraction,
            extent=-360 * remaining_fraction,
            fill=progress_color,
            outline="",
        )

        self.canvas.create_oval(
            cx - face_r, cy - face_r,
            cx + face_r, cy + face_r,
            fill="white",
            outline="",
        )

        for i in range(60):
            angle = math.radians(i * 6 - 90)

            if i % 5 == 0:
                inner = r - 20
                width = 4
            else:
                inner = r - 10
                width = 2

            x1 = cx + inner * math.cos(angle)
            y1 = cy + inner * math.sin(angle)
            x2 = cx + r * math.cos(angle)
            y2 = cy + r * math.sin(angle)

            self.canvas.create_line(
                x1, y1, x2, y2,
                width=width,
                fill="#303030",
            )

        m = int(self.remaining) // 60
        s = int(self.remaining) % 60
        font_size = int(self.radius / 7)

        self.canvas.create_text(
            cx, cy - 35,
            text=f"{m:02}:{s:02}",
            font=("Segoe UI", font_size, "bold"),
            fill="#222222",
        )

        self.canvas.create_text(
            cx, cy + 48,
            text="POZOSTAŁO",
            font=("Segoe UI", int(self.radius / 18)),
            fill="#777777",
        )

    def update(self):
        if not self.running:
            return

        elapsed = time.perf_counter() - self.start_time
        self.remaining = max(0, self.total_seconds - elapsed)
        self.draw_clock()

        if self.remaining > 0:
            self.control_root.after(16, self.update)
        else:
            self.running = False
            self.remaining = 0
            self.start_time = None
            self.pause_time = 0
            self.draw_clock()

            if SOUND:
                winsound.Beep(1000, 700)

            messagebox.showinfo("Timer", "Czas minął!", parent=self.control_root)

    def start(self):
        if self.running:
            return

        if self.start_time is None:
            self.start_time = time.perf_counter()
        else:
            self.start_time = time.perf_counter() - self.pause_time

        self.running = True
        self.update()

    def stop(self):
        if self.running:
            self.running = False
            self.pause_time = time.perf_counter() - self.start_time

    def reset(self):
        self.running = False
        self.total_seconds = self.minutes.get() * 60
        self.remaining = self.total_seconds
        self.start_time = None
        self.pause_time = 0
        self.draw_clock()

    def run(self):
        self.reset()
        self.control_root.mainloop()


if __name__ == "__main__":
    app = AnalogTimer()
    app.run()
